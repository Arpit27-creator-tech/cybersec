function handleDragOver(e) {
    e.preventDefault();
    var dropZone = document.getElementById('emlDropZone');
    if (dropZone) dropZone.style.borderColor = 'var(--safe)';
}

function handleDragLeave(e) {
    e.preventDefault();
    var dropZone = document.getElementById('emlDropZone');
    if (dropZone) dropZone.style.borderColor = 'rgba(255,255,255,.2)';
}

function handleFileDrop(e) {
    e.preventDefault();
    var dropZone = document.getElementById('emlDropZone');
    if (dropZone) dropZone.style.borderColor = 'rgba(255,255,255,.2)';
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        processEmlFile(e.dataTransfer.files[0]);
    }
}

function handleFileSelect(e) {
    if (e.target.files && e.target.files.length > 0) {
        processEmlFile(e.target.files[0]);
    }
}

function processEmlFile(file) {
    var status = document.getElementById('emlUploadStatus');
    var title = document.getElementById('emlDropTitle');
    
    if (title) title.innerHTML = '<span style="display:inline-block;animation:spin 1s linear infinite">⟳</span> Uploading ' + file.name + '...';
    if (status) {
        status.style.display = 'block';
        status.innerHTML = '<span style="display:inline-block;animation:spin 1s linear infinite">⟳</span> Parsing MIME headers, attachments & SPF/DKIM verification...';
    }

    var reader = new FileReader();
    reader.onload = function(evt) {
        var content = evt.target.result;
        fetch('/admin/email-scanner/upload-eml', {
            method: 'POST',
            headers: {
                'Content-Type': 'message/rfc822',
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            body: content
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                if (status) status.innerHTML = '<span style="color:var(--safe)">✓ Email parsed & threat report generated! Refreshing...</span>';
                setTimeout(function() {
                    window.location.href = '/admin/email-scanner';
                }, 800);
            } else {
                alert('EML Analysis Error: ' + (data.error || 'Failed to parse'));
                if (title) title.textContent = 'Drag & Drop .EML or Message File Here';
                if (status) status.style.display = 'none';
            }
        })
        .catch(function(err) {
            alert('Upload error analyzing EML file');
            if (title) title.textContent = 'Drag & Drop .EML or Message File Here';
            if (status) status.style.display = 'none';
        });
    };
    reader.readAsText(file);
}

