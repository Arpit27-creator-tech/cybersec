window.loadSampleScan = loadSampleScan;
window.handleDirectScan = handleDirectScan;
window.triggerDemoScan = triggerDemoScan;
window.closeThreatInspector = closeThreatInspector;
window.copyModalBrief = copyModalBrief;
window.switchModalTab = switchModalTab;

// ── Universal Capture-Phase Event Guard ──
// Intercepts and executes actions during the capture descent phase, guaranteed to run before any stopPropagation
document.addEventListener('click', function(e) {
    // 1. Any Close Button or Data-Close-Modal target
    var closeBtn = e.target.closest('.modal-close, [data-close-modal]');
    if (closeBtn) {
        if (e.preventDefault) e.preventDefault();
        var targetId = closeBtn.getAttribute('data-close-modal');
        var modal = targetId ? document.getElementById(targetId) : null;
        if (!modal) modal = closeBtn.closest('.modal-overlay');
        if (modal) {
            modal.style.setProperty('display', 'none', 'important');
            modal.classList.remove('active');
        }
        return false;
    }

    // 2. Copy Chrome Extensions URL
    var copyChromeBtn = e.target.closest('#btnCopyChromeUrl');
    if (copyChromeBtn) {
        if (e.preventDefault) e.preventDefault();
        copyChromeExtensionsUrl(copyChromeBtn);
        return false;
    }

    // 3. Copy Extension Folder Path
    var copyFolderBtn = e.target.closest('#btnCopyFolderPath');
    if (copyFolderBtn) {
        if (e.preventDefault) e.preventDefault();
        copyExtensionFolderPath(copyFolderBtn);
        return false;
    }

    // 4. Reveal in Finder
    var revealBtn = e.target.closest('#btnRevealFinder');
    if (revealBtn) {
        if (e.preventDefault) e.preventDefault();
        revealExtensionInFinder(revealBtn);
        return false;
    }

    // 5. Copy Brief in Threat Inspector
    var copyBriefBtn = e.target.closest('#btnCopyBrief');
    if (copyBriefBtn) {
        if (e.preventDefault) e.preventDefault();
        copyModalBrief(copyBriefBtn);
        return false;
    }

    // 6. Launch Gmail in new tab
    var gmailBtn = e.target.closest('#btnLaunchGmail');
    if (gmailBtn) {
        if (e.preventDefault) e.preventDefault();
        window.open('https://mail.google.com', '_blank');
        return false;
    }
}, true); // Capture phase: true

function attachModalTriggers() {
    function bindClick(id, handler) {
        var el = typeof id === 'string' ? document.getElementById(id) : id;
        if (!el) return;
        el.onclick = function(e) {
            if (e && e.preventDefault) e.preventDefault();
            handler(e, el);
            return false;
        };
        el.addEventListener('click', function(e) {
            if (e && e.preventDefault) e.preventDefault();
            handler(e, el);
        });
    }

    // Top action bar modal openers
    bindClick('btnExtensionSetup', function(e) { openExtensionModal(e); });
    bindClick('btnEmlUpload', function(e) { openEmlModal(e); });
    bindClick('btnTextScan', function(e) { openTextScanModal(e); });
    bindClick('btnDemoThreats', function(e, el) { triggerDemoScan(el); });

    // Extension setup modal inner controls
    bindClick('btnCloseExtensionModal', function(e) { closeExtensionModal(e); });
    bindClick('btnDoneExtensionModal', function(e) { closeExtensionModal(e); });
    bindClick('btnCopyChromeUrl', function(e, el) { copyChromeExtensionsUrl(el); });
    bindClick('btnCopyFolderPath', function(e, el) { copyExtensionFolderPath(el); });
    bindClick('btnRevealFinder', function(e, el) { revealExtensionInFinder(el); });
    bindClick('btnLaunchGmail', function() { window.open('https://mail.google.com', '_blank'); });

    // EML upload modal inner controls
    bindClick('btnCloseEmlModal', function(e) { closeEmlModal(e); });
    bindClick('btnCancelEmlModal', function(e) { closeEmlModal(e); });

    // Text scan modal inner controls
    bindClick('btnCloseTextScanModal', function(e) { closeTextScanModal(e); });
    bindClick('btnCancelTextScan', function(e) { closeTextScanModal(e); });
    bindClick('btnSamplePhish', function() { loadSampleScan('phish'); });
    bindClick('btnSampleSecret', function() { loadSampleScan('secret'); });
    bindClick('btnSamplePaypal', function() { loadSampleScan('paypal'); });
    bindClick('btnSampleClean', function() { loadSampleScan('clean'); });

    // Threat inspector modal inner controls
    bindClick('btnCloseThreatModal', function(e) { closeThreatInspector(e); });
    bindClick('btnDismissThreatBottom', function(e) { closeThreatInspector(e); });
    bindClick('btnCopyBrief', function(e, el) { copyModalBrief(el); });
    bindClick('tabBtnOverview', function() { switchModalTab('overview'); });
    bindClick('tabBtnIoc', function() { switchModalTab('ioc'); });
    bindClick('tabBtnMitre', function() { switchModalTab('mitre'); });
    bindClick('tabBtnPlaybook', function() { switchModalTab('playbook'); });
    bindClick('tabBtnRaw', function() { switchModalTab('raw'); });

    // Universal close buttons query
    document.querySelectorAll('.modal-close, [data-close-modal]').forEach(function(btn) {
        btn.onclick = function(e) {
            if (e && e.preventDefault) e.preventDefault();
            var targetId = btn.getAttribute('data-close-modal');
            var m = targetId ? document.getElementById(targetId) : null;
            if (!m) m = btn.closest('.modal-overlay');
            if (m) {
                m.style.setProperty('display', 'none', 'important');
                m.classList.remove('active');
            }
            return false;
        };
        btn.addEventListener('click', function(e) {
            if (e && e.preventDefault) e.preventDefault();
            var targetId = btn.getAttribute('data-close-modal');
            var m = targetId ? document.getElementById(targetId) : null;
            if (!m) m = btn.closest('.modal-overlay');
            if (m) {
                m.style.setProperty('display', 'none', 'important');
                m.classList.remove('active');
            }
        });
    });
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachModalTriggers);
} else {
    attachModalTriggers();
}
</script>
