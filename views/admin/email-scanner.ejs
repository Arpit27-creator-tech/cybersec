<script>
function triggerLiveScan() {
    var btn = document.getElementById('scanLiveBtn');
    if (!btn) return;
    var originalContent = btn.innerHTML;
    btn.innerHTML = '<span style="display:inline-block;animation:spin 1s linear infinite">⟳</span> Scanning Gmail...';
    btn.disabled = true;

    fetch('/admin/email-scanner/scan', {
        method: 'POST',
        headers: { 'X-CSRF-Token': '<%= csrfToken %>' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            window.location.href = '/admin/email-scanner?scanned=' + encodeURIComponent(data.count || 0);
        } else {
            alert('Scan error: ' + (data.error || 'Failed to scan inbox'));
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    })
    .catch(function(err) {
        alert('Network error during scan: ' + (err.message || 'Server timeout or connection failed'));
        btn.innerHTML = originalContent;
        btn.disabled = false;
    });
}

function triggerDemoScan(btn) {
    var triggerBtn = btn || (typeof event !== 'undefined' && event && event.target ? event.target.closest('button') : null);
    var origText = triggerBtn ? triggerBtn.innerHTML : null;
    if (triggerBtn) {
        triggerBtn.innerHTML = '<span style="display:inline-block;animation:spin 1s linear infinite">⟳</span> Simulating Threats...';
        triggerBtn.disabled = true;
    }

    fetch('/admin/email-scanner/demo-scan', {
        method: 'POST',
        headers: { 'X-CSRF-Token': '<%= csrfToken %>' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            window.location.href = '/admin/email-scanner';
        } else {
            alert('Error generating demo scan: ' + (data.error || 'Failed to generate demo'));
            if (triggerBtn) {
                triggerBtn.innerHTML = origText;
                triggerBtn.disabled = false;
            }
        }
    })
    .catch(function(err) {
        alert('Network error generating demo simulation');
        if (triggerBtn) {
            triggerBtn.innerHTML = origText;
            triggerBtn.disabled = false;
        }
    });
}

var currentModalReport = null;

function switchModalTab(tabName) {
    var tabs = ['overview', 'ioc', 'mitre', 'playbook', 'raw'];
    tabs.forEach(function(t) {
        var btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
        var pane = document.getElementById('pane' + t.charAt(0).toUpperCase() + t.slice(1));
        if (btn) btn.classList.remove('active');
        if (pane) pane.classList.remove('active');
    });
    var activeBtn = document.getElementById('tabBtn' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
    var activePane = document.getElementById('pane' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
    if (activeBtn) activeBtn.classList.add('active');
    if (activePane) activePane.classList.add('active');
}

function openThreatInspector(id) {
    switchModalTab('overview');

    fetch('/admin/email-scanner/email/' + id)
    .then(function(r) { return r.json(); })
    .then(function(data) {
        var report = data.forensicReport || {};
        currentModalReport = report;

        // Header
        document.getElementById('mCaseId').textContent = report.caseId || ('INCIDENT #' + data.id);
        var tBadge = document.getElementById('mThreatBadge');
        var lvl = (report.classification?.threatLevel || data.threat_level || 'safe');
        var scr = (report.classification?.threatScore !== undefined ? report.classification.threatScore : data.threat_score);
        tBadge.className = 'threat-badge threat-' + lvl;
        tBadge.textContent = lvl.toUpperCase() + ' (' + scr + '/100)';
        
        var cBadge = document.getElementById('mClassBadge');
        if (data.classification_category) {
            cBadge.style.display = 'inline-flex';
            cBadge.className = 'classification-pill class-' + data.classification_category;
            var confText = data.classification_confidence !== null && data.classification_confidence !== undefined ? ' (' + Math.round(data.classification_confidence * 100) + '%)' : '';
            cBadge.textContent = data.classification_category.toUpperCase().replace('_', ' ') + confText;
        } else {
            cBadge.style.display = 'none';
        }

        document.getElementById('mCvssBadge').textContent = 'CVSS: ' + (report.classification?.cvssScore || '0.0');
        document.getElementById('mTitle').textContent = report.classification?.attackType || data.subject;

        // Links
        document.getElementById('mDossierLink').href = '/admin/email-scanner/report/' + id;

        // Tab 1: Executive Overview
        document.getElementById('mVerdict').textContent = report.executiveSummary?.verdict || data.summary?.verdict || 'Analysis Completed';
        document.getElementById('mNarrative').textContent = report.executiveSummary?.technicalNarrative || report.executiveSummary?.overview || data.summary?.overview || data.body_text || '';
        
        document.getElementById('mMetaSender').textContent = (report.metadata?.senderName ? report.metadata.senderName + ' <' + report.metadata.sender + '>' : data.sender);
        document.getElementById('mMetaRecipient').textContent = report.metadata?.recipient || data.recipient || 'Internal Recipient';
        document.getElementById('mMetaDate').textContent = new Date(report.metadata?.timestamp || data.date).toLocaleString();
        
        var spoofEl = document.getElementById('mMetaSpoof');
        var spoofVerdict = report.forensics?.senderAnalysis?.spoofVerdict || 'VALID / UNTAMPERED';
        spoofEl.textContent = spoofVerdict;
        spoofEl.style.color = spoofVerdict === 'VALID / UNTAMPERED' ? 'var(--safe)' : 'var(--critical)';

        document.getElementById('mBlastScope').textContent = report.blastRadius?.scope || 'Workstation';
        document.getElementById('mBlastCreds').textContent = report.blastRadius?.dataExposureRisk || 'None';
        document.getElementById('mBlastLateral').textContent = report.blastRadius?.lateralMovementRisk || 'None';
        document.getElementById('mBlastCompliance').textContent = report.blastRadius?.complianceImpact || 'Standard Logging';

        // Tab 2: Forensic IOCs
        var pList = document.getElementById('mPhishingList');
        pList.innerHTML = '';
        var psychTriggers = report.forensics?.psychologicalTriggers || [];
        var allPhish = (data.phishing_reasons || []).concat(data.auth_issues || []);
        if (psychTriggers.length > 0) {
            document.getElementById('mPhishingSec').style.display = 'block';
            psychTriggers.forEach(function(p) {
                var li = document.createElement('li');
                li.className = 'warn';
                li.innerHTML = '<strong>' + p.intent + ':</strong> "' + p.context + '" <span style="color:var(--lab)">(' + p.tactic + ')</span>';
                pList.appendChild(li);
            });
        } else if (allPhish.length > 0) {
            document.getElementById('mPhishingSec').style.display = 'block';
            allPhish.forEach(function(r) {
                var li = document.createElement('li');
                li.className = 'warn';
                li.textContent = '⚠️ ' + r;
                pList.appendChild(li);
            });
        } else {
            document.getElementById('mPhishingSec').style.display = 'none';
        }

        var lList = document.getElementById('mLinksList');
        lList.innerHTML = '';
        var linksList = report.forensics?.linksAnalysis || data.malicious_links || [];
        if (linksList.length > 0) {
            document.getElementById('mLinksSec').style.display = 'block';
            linksList.forEach(function(l) {
                var li = document.createElement('li');
                li.className = 'warn';
                li.innerHTML = '🔗 <strong>' + (l.threatCategory || 'Suspicious URL') + ':</strong> <code style="word-break:break-all">' + l.url + '</code> (' + (l.tacticalRisk || l.reason) + ')';
                lList.appendChild(li);
            });
        } else {
            document.getElementById('mLinksSec').style.display = 'none';
        }

        var aList = document.getElementById('mAttList');
        aList.innerHTML = '';
        var attList = report.forensics?.attachmentsAnalysis || data.suspicious_attachments || [];
        if (attList.length > 0) {
            document.getElementById('mAttSec').style.display = 'block';
            attList.forEach(function(a) {
                var li = document.createElement('li');
                li.className = 'warn';
                li.innerHTML = '📎 <strong>' + (a.filename || 'Attachment') + '</strong> [' + (a.extension || '') + ']: ' + (a.payloadVector || a.risk || 'Dangerous file');
                aList.appendChild(li);
            });
        } else {
            document.getElementById('mAttSec').style.display = 'none';
        }

        var lkList = document.getElementById('mLeaksList');
        lkList.innerHTML = '';
        var leaksList = report.forensics?.dataLeaksAnalysis || data.leaked_secrets || [];
        if (leaksList.length > 0) {
            document.getElementById('mLeaksSec').style.display = 'block';
            leaksList.forEach(function(s) {
                var li = document.createElement('li');
                li.className = 'alert';
                li.innerHTML = '🔑 <strong>' + (s.secretType || s.type) + ':</strong> ' + (s.maskedSample || s.sample);
                lkList.appendChild(li);
            });
        } else {
            document.getElementById('mLeaksSec').style.display = 'none';
        }

        var totalIocs = linksList.length + attList.length + leaksList.length + psychTriggers.length;
        document.getElementById('mIocCount').textContent = totalIocs;
        document.getElementById('mCleanTelemetrySec').style.display = totalIocs === 0 ? 'block' : 'none';

        // Tab 3: MITRE ATT&CK
        var mitreGrid = document.getElementById('mMitreGrid');
        mitreGrid.innerHTML = '';
        var mitreTechs = report.mitreTechniques || [];
        document.getElementById('mMitreCount').textContent = mitreTechs.length;
        if (mitreTechs.length > 0) {
            mitreTechs.forEach(function(m) {
                var div = document.createElement('div');
                div.className = 'm-mitre-item';
                div.innerHTML = '<div style="font-family:\'JB\',monospace;font-size:11px;font-weight:700;color:var(--red)">' + m.id + '</div>' +
                                '<div style="font-weight:600;font-size:13px;color:#fff;margin:3px 0">' + m.name + '</div>' +
                                '<div style="font-family:\'JB\',monospace;font-size:10px;color:var(--lab);margin-bottom:6px">' + m.tactic + '</div>' +
                                '<div style="font-size:11px;color:#d4d4d8;line-height:1.4">' + m.description + '</div>';
                mitreGrid.appendChild(div);
            });
        } else {
            mitreGrid.innerHTML = '<div style="font-family:\'JB\',monospace;font-size:12px;color:var(--safe)">No offensive MITRE ATT&CK techniques identified for this communication.</div>';
        }

        // Tab 4: SOC Containment SOP
        var sopList = document.getElementById('mSopList');
        sopList.innerHTML = '';
        var sopSteps = report.containmentPlaybook || [];
        sopSteps.forEach(function(sop, idx) {
            var div = document.createElement('div');
            div.className = 'm-sop-step';
            div.innerHTML = '<div class="m-sop-num">' + (idx + 1) + '</div>' +
                            '<div style="flex:1">' +
                                '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">' +
                                    '<span style="font-weight:600;font-size:12px;color:#fff">' + sop.phase + '</span>' +
                                    '<span style="font-size:10px;padding:2px 6px;background:rgba(255,255,255,.06);color:var(--lab)">' + sop.priority + '</span>' +
                                '</div>' +
                                '<div style="font-size:12px;color:#ccc;line-height:1.4">' + sop.action + '</div>' +
                            '</div>';
            sopList.appendChild(div);
        });

        // Tab 5: Raw Decoded Message
        document.getElementById('mBodyText').textContent = data.body_text || '(No body text available)';

        document.getElementById('threatModal').classList.add('active');
    });
}

function copyModalBrief(btn) {
    if (!currentModalReport) return;
    var r = currentModalReport;
    var text = 'FORENSIC INCIDENT BRIEF: ' + (r.caseId || 'INCIDENT') + '\n' +
               'Classification: ' + (r.classification?.attackType || 'Security Incident') + '\n' +
               'Threat Score: ' + (r.classification?.threatScore || 0) + '/100 (' + (r.classification?.threatLevel || 'unknown').toUpperCase() + ')\n' +
               'CVSS: ' + (r.classification?.cvssScore || 0) + '\n' +
               'Sender: ' + (r.metadata?.sender || 'Unknown') + '\n' +
               'Target: ' + (r.metadata?.recipient || 'Internal') + '\n' +
               'Subject: ' + (r.metadata?.subject || 'N/A') + '\n\n' +
               'Verdict:\n' + (r.executiveSummary?.verdict || '') + '\n\n' +
               'Technical Narrative:\n' + (r.executiveSummary?.technicalNarrative || '');

    var triggerBtn = btn || document.getElementById('btnCopyBrief') || (typeof event !== 'undefined' && event && event.target ? event.target.closest('button') : null);
    copyTextToClipboard(text, function(ok) {
        if (triggerBtn) {
            var orig = triggerBtn.innerHTML;
            triggerBtn.innerHTML = '<span style="color:var(--safe);font-weight:700">✓ Brief Copied!</span>';
            setTimeout(function() { triggerBtn.innerHTML = orig; }, 2500);
        } else {
            alert('✓ Forensic incident brief copied to clipboard.');
        }
    });
}

// ── Chrome Extension Setup Modal Controllers ──
function openExtensionModal(e) {
    if (e && e.preventDefault) e.preventDefault();
    var modal = document.getElementById('extensionModal');
    if (!modal) {
        console.error('Modal #extensionModal not found in DOM');
        return;
    }
    modal.style.setProperty('display', 'flex', 'important');
    modal.classList.add('active');

    // Dynamically update stream endpoint with current host
    var streamEl = document.getElementById('extStreamUrl');
    var currentOrigin = window.location.origin;
    if (streamEl) {
        streamEl.textContent = currentOrigin + '/api/extension/scan';
    }

    // Adapt button text based on client operating system
    var revealLabel = document.getElementById('btnRevealFinderLabel');
    if (revealLabel) {
        var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
        if (/win/i.test(p)) {
            revealLabel.textContent = '📂 Reveal in File Explorer';
        } else if (/mac/i.test(p)) {
            revealLabel.textContent = '📂 Reveal in Mac Finder';
        } else {
            revealLabel.textContent = '📂 Reveal in File Manager';
        }
    }

    // Check extension backend stream health & get server-side extension path
    try {
        fetch('/api/extension/status')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var dot = document.getElementById('extServerDot');
                var text = document.getElementById('extServerStatusText');
                var badge = document.getElementById('extServerBadge');
                var disp = document.getElementById('extensionPathDisplay');

                if (data && data.folderPath && disp && (!disp.textContent || !disp.textContent.trim())) {
                    disp.textContent = data.folderPath;
                }

                if (data && data.online) {
                    if (dot) dot.style.background = '#00E5FF';
                    if (text) text.innerHTML = 'Telemetry Stream Endpoint: <strong style="color:#00E5FF">' + currentOrigin + '/api/extension/scan</strong> (' + (data.stats ? data.stats.totalScans : 0) + ' processed)';
                    if (badge) {
                        badge.textContent = '● SERVER ONLINE';
                        badge.style.color = '#00E5FF';
                        badge.style.borderColor = 'rgba(0,229,255,.3)';
                    }
                }
            })
            .catch(function(_) {});
    } catch (_) {}
}

function closeExtensionModal(e) {
    if (e && e.preventDefault) e.preventDefault();
    if (e && e.stopPropagation) e.stopPropagation();
    var modal = document.getElementById('extensionModal');
    if (modal) {
        modal.style.setProperty('display', 'none', 'important');
        modal.classList.remove('active');
    }
}

function copyChromeExtensionsUrl(btn) {
    var triggerBtn = btn || document.getElementById('btnCopyChromeUrl') || (typeof event !== 'undefined' && event && event.target ? event.target.closest('button') : null);
    var url = 'chrome://extensions';
    copyTextToClipboard(url, function(ok) {
        if (triggerBtn) {
            var orig = triggerBtn.getAttribute('data-orig-html') || triggerBtn.innerHTML;
            triggerBtn.setAttribute('data-orig-html', orig);
            triggerBtn.innerHTML = '<span style="color:#00E5FF;font-weight:700">✓ chrome://extensions Copied!</span>';
            triggerBtn.style.borderColor = '#00E5FF';
            setTimeout(function() {
                triggerBtn.innerHTML = orig;
                triggerBtn.style.borderColor = '';
            }, 2500);
        } else {
            alert('✓ Copied chrome://extensions to clipboard!');
        }
    });
}

function copyExtensionFolderPath(btn) {
    var triggerBtn = btn || document.getElementById('btnCopyFolderPath') || (typeof event !== 'undefined' && event && event.target ? event.target.closest('button') : null);
    var disp = document.getElementById('extensionPathDisplay');
    var folderPath = (disp ? disp.textContent.trim() : '') || window.EXTENSION_FOLDER_PATH || '';
    
    if (disp) {
        try {
            var range = document.createRange();
            range.selectNodeContents(disp);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
        } catch (_) {}
    }

    if (!folderPath) {
        folderPath = window.location.origin + '/api/extension/download';
    }

    copyTextToClipboard(folderPath, function(ok) {
        if (triggerBtn) {
            var orig = triggerBtn.getAttribute('data-orig-html') || triggerBtn.innerHTML;
            triggerBtn.setAttribute('data-orig-html', orig);
            triggerBtn.innerHTML = '<span style="color:#00E5FF;font-weight:700">✓ Path Copied to Clipboard!</span>';
            setTimeout(function() {
                triggerBtn.innerHTML = orig;
            }, 2500);
        } else {
            alert('✓ Copied Extension Folder Path to clipboard!');
        }
    });
}

function revealExtensionInFinder(btn) {
    var triggerBtn = btn || document.getElementById('btnRevealFinder') || (typeof event !== 'undefined' && event && event.target ? event.target.closest('button') : null);
    var orig = triggerBtn ? (triggerBtn.getAttribute('data-orig-html') || triggerBtn.innerHTML) : null;
    if (triggerBtn) {
        triggerBtn.setAttribute('data-orig-html', orig);
        triggerBtn.innerHTML = '<span style="display:inline-block;animation:spin 1s linear infinite">⟳</span> Opening...';
        triggerBtn.disabled = true;
    }

    fetch('/api/extension/reveal-finder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            if (triggerBtn) {
                triggerBtn.innerHTML = '<span style="color:#00E5FF">✓ Opened in Folder!</span>';
                setTimeout(function() {
                    triggerBtn.innerHTML = orig;
                    triggerBtn.disabled = false;
                }, 2500);
            }
        } else {
            alert('Could not open folder automatically: ' + (data.error || 'System file manager not reachable') + '\n\nPlease copy the folder path or click Download Extension (.zip).');
            if (triggerBtn) {
                triggerBtn.innerHTML = orig;
                triggerBtn.disabled = false;
            }
        }
    })
    .catch(function(err) {
        alert('Host server file manager not reachable. If opening on a separate PC, please click Download Extension (.zip).');
        if (triggerBtn) {
            triggerBtn.innerHTML = orig;
            triggerBtn.disabled = false;
        }
    });
}

