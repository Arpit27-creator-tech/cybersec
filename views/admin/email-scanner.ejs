</div>

<!-- Chrome Extension Setup Modal -->
<div class="modal-overlay" id="extensionModal">
    <div class="modal-card" style="max-width:740px">
        <div class="modal-header">
            <div style="display:flex;align-items:center;gap:12px">
                <div style="width:36px;height:36px;background:rgba(0,229,255,.12);border:1px solid rgba(0,229,255,.3);display:flex;align-items:center;justify-content:center;font-size:18px">🛡️</div>
                <div>
                    <h3 style="font-size:18px;font-weight:700;color:#fff">Chrome Extension Setup & Activation</h3>
                    <div style="font-family:'JB','JetBrains Mono',monospace;font-size:11px;color:#00E5FF;margin-top:2px">
                        ZERO PASSWORDS • ZERO OAUTH • LIVE IN GMAIL
                    </div>
                </div>
            </div>
            <button type="button" id="btnCloseExtensionModal" class="modal-close" data-close-modal="extensionModal" onclick="closeExtensionModal(event)" aria-label="Close modal">✕</button>
        </div>
        <div class="modal-body" style="gap:18px">
            <!-- Server Health Banner -->
            <div style="background:rgba(0,229,255,.05);border:1px solid rgba(0,229,255,.25);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
                <div style="display:flex;align-items:center;gap:10px">
                    <div id="extServerDot" style="width:8px;height:8px;border-radius:50%;background:#00E5FF;box-shadow:0 0 10px #00E5FF"></div>
                    <span id="extServerStatusText" style="font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:#fff">
                        Telemetry Stream Endpoint: <strong style="color:#00E5FF" id="extStreamUrl"><%= typeof streamEndpoint !== 'undefined' ? streamEndpoint : 'http://localhost:3000/api/extension/scan' %></strong>
                    </span>
                </div>
                <span id="extServerBadge" style="font-family:'JB','JetBrains Mono',monospace;font-size:11px;color:#00E5FF;background:rgba(0,229,255,.15);padding:3px 8px;border:1px solid rgba(0,229,255,.3)">● SERVER ONLINE</span>
            </div>

            <!-- Steps -->
            <div style="display:flex;flex-direction:column;gap:14px">
                <!-- Step 1 -->
                <div style="background:rgba(255,255,255,.02);border:1px solid var(--border);padding:16px;display:flex;gap:14px">
                    <div style="width:28px;height:28px;background:rgba(0,229,255,.15);color:#00E5FF;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0">1</div>
                    <div style="flex:1">
                        <div style="font-weight:600;font-size:14px;color:#fff;margin-bottom:4px">Open Chrome Extensions Manager</div>
                        <div style="font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:var(--lab);margin-bottom:10px;line-height:1.5">
                            Open a new tab in Google Chrome, navigate to <code style="color:#00E5FF;background:rgba(255,255,255,.06);padding:2px 6px">chrome://extensions</code>, and turn on the <strong style="color:#fff">"Developer mode"</strong> toggle switch in the top-right corner.
                        </div>
                        <button type="button" id="btnCopyChromeUrl" class="btn-action btn-secondary" style="font-size:12px;padding:6px 14px" onclick="copyChromeExtensionsUrl(this)">
                            <span>📋 Copy chrome://extensions</span>
                        </button>
                    </div>
                </div>

                <!-- Step 2 -->
                <div style="background:rgba(255,255,255,.02);border:1px solid var(--border);padding:16px;display:flex;gap:14px">
                    <div style="width:28px;height:28px;background:rgba(0,229,255,.15);color:#00E5FF;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0">2</div>
                    <div style="flex:1">
                        <div style="font-weight:600;font-size:14px;color:#fff;margin-bottom:4px">Get Extension & Click "Load unpacked"</div>
                        <div style="font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:var(--lab);margin-bottom:12px;line-height:1.5">
                            In Chrome Extensions, click the <strong style="color:#fff">"Load unpacked"</strong> button and select the extension folder using either method below:
                        </div>

                        <!-- Method A: Download for any PC / Remote access -->
                        <div style="background:rgba(0,229,255,.03);border:1px dashed rgba(0,229,255,.3);padding:12px 14px;margin-bottom:12px">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:6px">
                                <span style="font-size:13px;font-weight:700;color:#fff">📦 Option A: Download Extension to This PC (Any Computer)</span>
                                <span style="font-family:'JB','JetBrains Mono',monospace;font-size:10px;color:#00E5FF;background:rgba(0,229,255,.12);padding:2px 6px">Recommended if on another PC</span>
                            </div>
                            <div style="font-family:'JB','JetBrains Mono',monospace;font-size:11px;color:var(--lab);margin-bottom:10px;line-height:1.5">
                                Download the extension package directly to this PC, extract it anywhere (e.g., Downloads or Desktop), and select that extracted folder in Chrome:
                            </div>
                            <a href="/api/extension/download" id="btnDownloadExtZip" class="btn-action" style="background:#00E5FF;color:#0B0F19;font-weight:700;font-size:12px;padding:8px 16px;text-decoration:none;display:inline-flex;align-items:center;gap:6px" download="cybersec-extension.zip">
                                <span>📥 Download Extension (.zip)</span>
                            </a>
                        </div>

                        <!-- Method B: Local repo path if server is running on this PC -->
                        <div style="background:rgba(255,255,255,.02);border:1px solid var(--border);padding:12px 14px">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:6px">
                                <span style="font-size:13px;font-weight:700;color:#fff">📁 Option B: Local Repository Path (When running on this PC)</span>
                                <span style="font-family:'JB','JetBrains Mono',monospace;font-size:10px;color:var(--lab)">Auto-detected for this system</span>
                            </div>
                            <div id="extensionPathDisplay" style="background:#000;border:1px solid var(--border);padding:10px 14px;font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:#00E5FF;word-break:break-all;margin-bottom:10px;user-select:all;-webkit-user-select:all;cursor:text" title="Click to select folder path"><%= typeof extensionFolderPath !== 'undefined' ? extensionFolderPath : '' %></div>
                            <div style="display:flex;gap:10px;flex-wrap:wrap">
                                <button type="button" id="btnCopyFolderPath" class="btn-action" style="background:rgba(255,255,255,.08);color:#fff;border:1px solid var(--border);font-weight:600;font-size:12px;padding:8px 14px" onclick="copyExtensionFolderPath(this)">
                                    <span>📋 Copy Folder Path</span>
                                </button>
                                <button type="button" id="btnRevealFinder" class="btn-action btn-secondary" style="font-size:12px;padding:8px 14px" onclick="revealExtensionInFinder(this)">
                                    <span id="btnRevealFinderLabel"><%= (typeof serverPlatform !== 'undefined' && serverPlatform === 'win32') ? '📂 Reveal in File Explorer' : ((typeof serverPlatform !== 'undefined' && serverPlatform === 'darwin') ? '📂 Reveal in Mac Finder' : '📂 Reveal in Folder') %></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3 -->
                <div style="background:rgba(255,255,255,.02);border:1px solid var(--border);padding:16px;display:flex;gap:14px">
                    <div style="width:28px;height:28px;background:rgba(0,229,255,.15);color:#00E5FF;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0">3</div>
                    <div style="flex:1">
                        <div style="font-weight:600;font-size:14px;color:#fff;margin-bottom:4px">Open Gmail — Automatic Threat Protection</div>
                        <div style="font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:var(--lab);margin-bottom:10px;line-height:1.5">
                            Open Gmail. Whenever you view any email, CyberSec injects an interactive Threat Assessment Banner right at the top, inspects all links and payloads, and streams the intelligence report to this dashboard in real-time!
                        </div>
                        <button type="button" id="btnLaunchGmail" class="btn-action btn-secondary" style="font-size:12px;padding:8px 16px" onclick="window.open('https://mail.google.com', '_blank')">
                            <span>✉️ Launch Gmail in New Tab ↗</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bottom Action Footer -->
            <div style="display:flex;justify-content:flex-end;align-items:center;gap:12px;padding-top:14px;border-top:1px solid var(--border);margin-top:6px">
                <button type="button" id="btnDoneExtensionModal" class="btn-action" style="background:rgba(255,255,255,.08);color:#fff;border:1px solid var(--border);padding:10px 22px;font-size:13px;cursor:pointer" data-close-modal="extensionModal" onclick="closeExtensionModal(event)">
                    <span>✕ Close Window</span>
