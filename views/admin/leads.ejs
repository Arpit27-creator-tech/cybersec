<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Leads — CyberSec Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&family=Space+Grotesk:wght@300;400;500;600;700&display=block" rel="stylesheet">
    <style>
        @font-face{font-family:'SG';src:local('Space Grotesk');font-display:block}
        @font-face{font-family:'JB';src:local('JetBrains Mono');font-display:block}
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
        html{min-height:100%;background:#0a0a0a}
        body{-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision;color:#fff;font-family:'SG','Space Grotesk',sans-serif}
        a{color:inherit;text-decoration:none}
        :root{--red:#c81b1c;--ink:#fff;--sub:#e6e6e6;--lab:#949494;--card:#111;--border:rgba(255,255,255,.08)}
        .shell{display:flex;min-height:100vh}
        .side{width:240px;background:#080808;border-right:1px solid var(--border);padding:28px 20px;flex-shrink:0;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}
        .side-logo{display:flex;align-items:center;gap:12px;margin-bottom:40px}
        .side-logo svg{width:32px;height:32px}
        .side-logo span{font-weight:700;font-size:16px;letter-spacing:-.4px}
        .side-nav{display:flex;flex-direction:column;gap:4px}
        .side-nav a{display:flex;align-items:center;gap:10px;padding:10px 12px;font-family:'JB','JetBrains Mono',monospace;font-size:13px;color:var(--lab);transition:all .2s;border-left:2px solid transparent}
        .side-nav a:hover,.side-nav a.active{color:var(--ink);background:rgba(255,255,255,.04);border-left-color:var(--red)}
        .side-nav a.active{color:var(--red)}
        .side-nav .sep{height:1px;background:var(--border);margin:16px 0}
        .side-bottom{margin-top:auto;padding-top:20px;border-top:1px solid var(--border)}
        .side-user{font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:var(--lab);margin-bottom:12px}
        .side-user strong{color:var(--ink);display:block;font-size:13px;margin-bottom:2px}
        .logout-btn{font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:var(--lab);background:none;border:1px solid var(--border);padding:8px 14px;cursor:pointer;transition:all .2s;border-radius:0;width:100%}
        .logout-btn:hover{color:var(--red);border-color:var(--red)}
        .main{flex:1;padding:32px 40px;overflow-x:auto}
        .main h1{font-size:28px;font-weight:700;letter-spacing:-1px;margin-bottom:8px}
        .main .subtitle{font-family:'JB','JetBrains Mono',monospace;font-size:13px;color:var(--lab);margin-bottom:24px}

        /* Toolbar */
        .toolbar{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap;align-items:center}
        .toolbar input[type="text"]{background:rgba(255,255,255,.05);border:1px solid var(--border);color:#fff;font-family:'JB','JetBrains Mono',monospace;font-size:13px;padding:10px 14px;outline:none;width:260px;border-radius:0}
        .toolbar input:focus{border-color:var(--red)}
        .toolbar select{background:#111;border:1px solid var(--border);color:var(--sub);font-family:'JB','JetBrains Mono',monospace;font-size:13px;padding:10px 14px;outline:none;border-radius:0;cursor:pointer}
        .toolbar .count{font-family:'JB','JetBrains Mono',monospace;font-size:12px;color:var(--lab);margin-left:auto}

        .tbl-wrap{background:var(--card);border:1px solid var(--border);overflow-x:auto}
        table{width:100%;border-collapse:collapse}
        th{font-family:'JB','JetBrains Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--lab);text-align:left;padding:12px 20px;border-bottom:1px solid var(--border);font-weight:400}
        td{padding:14px 20px;border-bottom:1px solid var(--border);font-family:'JB','JetBrains Mono',monospace;font-size:13px;color:var(--sub)}
        tr:last-child td{border-bottom:none}
        td.name{color:var(--ink);font-weight:480}
        .badge{display:inline-block;padding:4px 10px;font-size:11px;letter-spacing:.05em;text-transform:uppercase;font-family:'JB','JetBrains Mono',monospace}
        .badge-new{background:rgba(200,27,28,.15);color:#ef4444}
        .badge-contacted{background:rgba(59,130,246,.15);color:#3b82f6}
        .badge-qualified{background:rgba(34,197,94,.15);color:#22c55e}
        .badge-closed{background:rgba(148,148,148,.15);color:var(--lab)}

        .actions{display:flex;gap:8px;align-items:center}
        .actions select{background:#0a0a0a;border:1px solid var(--border);color:var(--sub);font-family:'JB','JetBrains Mono',monospace;font-size:11px;padding:6px 8px;border-radius:0;cursor:pointer}
        .del-btn{background:none;border:1px solid rgba(239,68,68,.3);color:#ef4444;font-family:'JB','JetBrains Mono',monospace;font-size:11px;padding:6px 10px;cursor:pointer;border-radius:0;transition:all .2s}
        .del-btn:hover{background:rgba(239,68,68,.15);border-color:#ef4444}

        .pager{display:flex;gap:8px;margin-top:20px;justify-content:center}
        .pager a{font-family:'JB','JetBrains Mono',monospace;font-size:13px;padding:8px 14px;color:var(--lab);border:1px solid var(--border);transition:all .2s}
        .pager a:hover{color:var(--ink);border-color:var(--red)}
        .pager a.current{color:var(--red);border-color:var(--red)}
        .empty{padding:40px;text-align:center;font-family:'JB','JetBrains Mono',monospace;font-size:14px;color:var(--lab)}
        .msg-preview{max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

        @media(max-width:768px){
            .shell{flex-direction:column}
            .side{width:100%;height:auto;position:relative;flex-direction:row;flex-wrap:wrap;padding:16px;align-items:center}
            .side-logo{margin-bottom:0;margin-right:auto}
            .side-nav{flex-direction:row;width:100%;margin-top:12px}
            .side-nav a{padding:8px 10px;font-size:12px;border-left:none;border-bottom:2px solid transparent}
            .side-nav a:hover,.side-nav a.active{border-left:none;border-bottom-color:var(--red)}
            .side-nav .sep{display:none}
            .side-bottom{margin-top:0;border-top:none;padding-top:0}
            .main{padding:20px 16px}
            .toolbar input[type="text"]{width:100%}
        }
        :focus-visible{outline:2px solid #fff;outline-offset:3px}
    </style>
</head>
<body>
<div class="shell">
    <aside class="side">
        <a href="/" class="side-logo">
            <svg viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg"><g stroke="#fff" stroke-width="3" stroke-linecap="butt"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g><g stroke="#fff" stroke-width="3" stroke-linecap="butt" transform="rotate(90,23,23)"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g><g stroke="#fff" stroke-width="3" stroke-linecap="butt" transform="rotate(180,23,23)"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g><g stroke="#fff" stroke-width="3" stroke-linecap="butt" transform="rotate(270,23,23)"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g></svg>
            <span>CyberSec</span>
        </a>
        <nav class="side-nav">
            <a href="/admin">◆ Dashboard</a>
            <a href="/admin/leads" class="active">◆ Leads</a>
            <a href="/admin/newsletter">◆ Newsletter</a>
            <a href="/admin/email-scanner">◆ Email Scanner</a>
            <div class="sep"></div>
            <a href="/admin/settings">◆ Settings</a>
            <a href="/" target="_blank">◆ View Site</a>
        </nav>
        <div class="side-bottom">
            <div class="side-user"><strong><%= user.username %></strong><%= user.role %></div>
            <form action="/auth/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="logout-btn">Sign out</button></form>
        </div>
    </aside>
    <main class="main">
        <h1>Leads</h1>
        <p class="subtitle">All contact form submissions</p>

        <form class="toolbar" method="GET" action="/admin/leads">
            <input type="text" name="search" placeholder="Search name, email, company..." value="<%= search %>">
            <select name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                <option value="new" <%= status==='new'?'selected':'' %>>New</option>
                <option value="contacted" <%= status==='contacted'?'selected':'' %>>Contacted</option>
                <option value="qualified" <%= status==='qualified'?'selected':'' %>>Qualified</option>
                <option value="closed" <%= status==='closed'?'selected':'' %>>Closed</option>
            </select>
            <button type="submit" style="display:none"></button>
            <span class="count"><%= total %> total</span>
        </form>

        <div class="tbl-wrap">
            <% if (leads.length === 0) { %>
            <div class="empty">No leads match your filters.</div>
            <% } else { %>
            <table>
                <thead><tr><th>Name</th><th>Email</th><th>Company</th><th>Message</th><th>Source</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
                <tbody>
                <% leads.forEach(function(lead) { %>
                <tr id="lead-<%= lead.id %>">
                    <td class="name"><%= lead.name %></td>
                    <td><a href="mailto:<%= lead.email %>" style="color:var(--red)"><%= lead.email %></a></td>
                    <td><%= lead.company || '—' %></td>
                    <td class="msg-preview" title="<%= lead.message %>"><%= lead.message %></td>
                    <td><%= lead.source %></td>
                    <td><span class="badge badge-<%= lead.status %>"><%= lead.status %></span></td>
                    <td><%= new Date(lead.created_at).toLocaleDateString() %></td>
                    <td>
                        <div class="actions">
                            <select onchange="updateStatus(<%= lead.id %>, this.value)">
                                <option value="new" <%= lead.status==='new'?'selected':'' %>>New</option>
                                <option value="contacted" <%= lead.status==='contacted'?'selected':'' %>>Contacted</option>
                                <option value="qualified" <%= lead.status==='qualified'?'selected':'' %>>Qualified</option>
                                <option value="closed" <%= lead.status==='closed'?'selected':'' %>>Closed</option>
                            </select>
                            <button class="del-btn" onclick="deleteLead(<%= lead.id %>)">✕</button>
                        </div>
                    </td>
                </tr>
                <% }); %>
                </tbody>
            </table>
            <% } %>
        </div>

        <% if (totalPages > 1) { %>
        <div class="pager">
            <% for(var p = 1; p <= totalPages; p++) { %>
            <a href="/admin/leads?page=<%= p %>&status=<%= status %>&search=<%= search %>" class="<%= p === page ? 'current' : '' %>"><%= p %></a>
            <% } %>
        </div>
        <% } %>
    </main>
</div>
<script>
function updateStatus(id, status) {
    fetch('/admin/leads/' + id, {
        method: 'PATCH',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({ status: status })
    }).then(function(r) { if (r.ok) location.reload(); });
}
function deleteLead(id) {
    if (!confirm('Delete this lead permanently?')) return;
    fetch('/admin/leads/' + id, {
        method: 'DELETE',
        headers: {
            'X-CSRF-Token': '<%= csrfToken %>'
        }
    })
    .then(function(r) { if (r.ok) document.getElementById('lead-' + id).remove(); });
}
</script>
</body>
</html>
