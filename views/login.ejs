<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login — CyberSec Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&family=Space+Grotesk:wght@300;400;500;600;700&display=block" rel="stylesheet">
    <style>
        @font-face{font-family:'SG';src:local('Space Grotesk');font-display:block}
        @font-face{font-family:'JB';src:local('JetBrains Mono');font-display:block}
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
        html,body{min-height:100%;background:#000}
        body{-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision;color:#fff;font-family:'SG','Space Grotesk',sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh}
        a{color:inherit;text-decoration:none}
        :root{--red:#c81b1c;--ink:#fff;--sub:#e6e6e6;--lab:#949494}

        .auth-card{width:100%;max-width:420px;padding:40px 24px}
        .auth-logo{display:flex;justify-content:center;margin-bottom:40px}
        .auth-logo svg{width:48px;height:48px}
        .auth-eyebrow{font-family:'JB','JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--lab);text-align:center;margin-bottom:8px}
        .auth-title{font-weight:700;font-size:32px;letter-spacing:-1.2px;text-align:center;margin-bottom:32px}

        .field{margin-bottom:16px}
        .field label{display:block;font-family:'JB','JetBrains Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--lab);margin-bottom:6px}
        .field input{
            width:100%;background:rgba(255,255,255,.05);
            border:1px solid rgba(255,255,255,.12);border-radius:0;
            color:#fff;font-family:'JB','JetBrains Mono',monospace;font-size:15px;
            padding:14px 16px;outline:none;transition:border-color .2s;
        }
        .field input:focus{border-color:var(--red)}
        .field input::placeholder{color:rgba(255,255,255,.25)}

        .auth-btn{
            width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
            background:var(--red);color:#fff;border:none;cursor:pointer;
            padding:16px;margin-top:24px;
            font-family:'SG','Space Grotesk',sans-serif;font-weight:500;font-size:18px;letter-spacing:-.4px;
            transition:background .2s;border-radius:0;
        }
        .auth-btn:hover{background:#b01617}
        .auth-btn svg{width:18px;height:14px;transition:transform .25s}
        .auth-btn:hover svg{transform:translateX(3px)}

        .auth-footer{text-align:center;margin-top:24px;font-family:'JB','JetBrains Mono',monospace;font-size:13px;color:var(--lab)}
        .auth-footer a{color:var(--sub);transition:color .2s}
        .auth-footer a:hover{color:var(--red)}

        .alert{padding:12px 16px;margin-bottom:20px;font-family:'JB','JetBrains Mono',monospace;font-size:13px;border-left:3px solid;background:rgba(200,27,28,.08);color:#ef4444;border-color:#ef4444}
        :focus-visible{outline:2px solid #fff;outline-offset:3px}
    </style>
</head>
<body>
<div class="auth-card">
    <a href="/" class="auth-logo">
        <svg viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g stroke="#fff" stroke-width="3" stroke-linecap="butt"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g>
            <g stroke="#fff" stroke-width="3" stroke-linecap="butt" transform="rotate(90,23,23)"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g>
            <g stroke="#fff" stroke-width="3" stroke-linecap="butt" transform="rotate(180,23,23)"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g>
            <g stroke="#fff" stroke-width="3" stroke-linecap="butt" transform="rotate(270,23,23)"><line x1="23" y1="0" x2="23" y2="19.5"/><polyline points="14,10.2 23,19.2 32,10.2" fill="none"/></g>
        </svg>
    </a>
    <div class="auth-eyebrow">Admin Access</div>
    <h1 class="auth-title">Sign in</h1>

    <% if (errors && errors.length) { %>
    <div class="alert"><%= errors.join('. ') %></div>
    <% } %>

    <form action="/auth/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="admin" required value="<%= values.username || '' %>" autocomplete="username">
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="auth-btn">
            Sign in
            <svg viewBox="0 0 21 18" fill="none"><path d="M0 9H20.1" stroke="#fff" stroke-width="2"/><path d="M12.1 1L20.1 9L12.1 17" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </form>
    <div class="auth-footer">
        Don't have an account? <a href="/register">Register</a>
    </div>
    <div class="auth-footer" style="margin-top:12px">
        <a href="/">← Back to site</a>
    </div>
</div>
</body>
</html>
