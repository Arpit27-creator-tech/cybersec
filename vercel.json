{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cybersec-crm.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://cybersec-crm.onrender.com/auth/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://cybersec-crm.onrender.com/admin/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://cybersec-crm.onrender.com/admin"
    },
    {
      "source": "/contact",
      "destination": "https://cybersec-crm.onrender.com/contact"
    },
    {
      "source": "/login",
      "destination": "https://cybersec-crm.onrender.com/login"
    },
    {
      "source": "/register",
      "destination": "https://cybersec-crm.onrender.com/register"
    }
  ]
}
